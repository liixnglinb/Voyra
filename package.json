{
  "name": "localhub-web",
  "version": "1.0.0",
  "description": "LocalHub 云端网页版前端",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node build-tools/build-mindmap.mjs && node build-tools/build-education-helper.mjs",
    "dev": "vite",
    "prebuild": "node build-tools/build-mindmap.mjs && node build-tools/build-education-helper.mjs",
    "build": "vite build",
    "build:downloads": "node build-tools/build-download-pages.mjs",
    "test:downloads": "node build-tools/verify-download-pages.mjs",
    "test:schedule": "node build-tools/verify-schedule-dialogs.mjs",
    "test:schedule:import:data": "node --test build-tools/schedule-import.test.mjs",
    "test:schedule:sync:data": "node --test build-tools/schedule-cloud.test.mjs",
    "test:schedule:sync:ui": "node build-tools/verify-schedule-sync.mjs",
    "test:schedule:import:ui": "node build-tools/verify-schedule-import.mjs",
    "build:education": "node build-tools/build-education-helper.mjs",
    "test:education:data": "node --test build-tools/education-automation.test.mjs",
    "test:education:ui": "node build-tools/verify-education-helper.mjs",
    "test:performance": "node build-tools/verify-homepage-performance.mjs",
    "test:edgeone:proxy": "node --test build-tools/edgeone-origin-proxy.test.mjs",
    "build:edgeone:preview": "node build-tools/prepare-edgeone-preview.mjs",
    "test:health:data": "node --test build-tools/health-records.test.mjs",
    "test:health:ui": "node build-tools/verify-health-log.mjs",
    "prepreview": "node build-tools/build-mindmap.mjs",
    "preview": "vite preview",
    "test:ui": "node --test scripts/ui-design-system.test.mjs",
    "ui:spec": "node scripts/generate-ui-spec.mjs",
    "ui:spec:check": "node scripts/generate-ui-spec.mjs --check",
    "test:software-ui": "node scripts/software-ui-regression.mjs",
    "cards:palette": "node scripts/check-palette.mjs",
    "cards:verify": "node scripts/verify-cards.mjs",
    "cards:a11y": "node scripts/verify-a11y.mjs",
    "cards:shots": "node scripts/shot-clean.mjs",
    "cards:shots:each": "node scripts/shot-per-card.mjs"
  },
  "dependencies": {
    "@dicebear/core": "^9.4.3",
    "@dicebear/pixel-art": "^9.4.2",
    "hydrogen-js-sdk": "^3.0.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.21.5",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.9",
    "vite": "^5.4.2",
    "wrangler": "^4.86.0"
  }
}
